 <script type="text/javascript">
        let selectedMethod = null;

        function selectLoginMethod(method) {
            // Hide all forms
            document.querySelectorAll('.login-form').forEach(form => {
                form.classList.remove('active');
            });

            // Remove active class from all methods
            document.querySelectorAll('.login-method').forEach(methodEl => {
                methodEl.classList.remove('active');
            });

            // Show selected form and activate method
            document.getElementById(method + '-form').classList.add('active');
            document.getElementById(method + '-method').classList.add('active');
            
            selectedMethod = method;

            // Scroll to form on mobile
            if (window.innerWidth <= 768) {
                setTimeout(() => {
                    document.getElementById(method + '-form').scrollIntoView({ 
                        behavior: 'smooth', 
                        block: 'center' 
                    });
                }, 100);
            }
        }

        function resetSelection() {
            document.querySelectorAll('.login-form').forEach(form => {
                form.classList.remove('active');
            });

            document.querySelectorAll('.login-method').forEach(methodEl => {
                methodEl.classList.remove('active');
            });

            selectedMethod = null;
        }

        function handleLogin(event, method) {
            event.preventDefault();
            
            // This is a demo - in real implementation, you would send data to server
            const errorDiv = document.getElementById('error-message' + (method !== 'ic' ? '-' + method : ''));
            errorDiv.style.display = 'block';
            errorDiv.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i>Demo: Maklumat log masuk tidak sah. Sila cuba lagi.';
            
            // Hide error after 3 seconds
            setTimeout(() => {
                errorDiv.style.display = 'none';
            }, 3000);
        }

        function sendOTP() {
            const phoneInput = document.getElementById('phone-input');
            if (phoneInput.value.length < 10) {
                alert('Sila masukkan nombor telefon yang sah');
                return;
            }
            
            // Demo OTP sending
            alert('Kod OTP telah dihantar ke ' + phoneInput.value + '\nDemo kod: 123456');
        }

        function showForgotPassword() {
            alert('Demo: Halaman lupa katalaluan akan dibuka');
        }

        function showRegistration() {
            alert('Demo: Halaman pendaftaran akaun baru akan dibuka');
        }

        // Auto-select IC method on page load for better UX
        document.addEventListener('DOMContentLoaded', function() {
            // Don't auto-select on mobile to show all options first
            if (window.innerWidth > 768) {
                //selectLoginMethod('ic');
            }
        });
    </script>


