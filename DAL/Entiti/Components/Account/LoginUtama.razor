                            <i class="bi bi-chevron-right"></i>
                        </div>
                    </div>
                </div>

                             
              <EditForm Model="@modelDB" FormName="Mains" OnValidSubmit="LoginRecord">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <!-- IC Login Form -->
                <div class="login-form" id="ic-form">
                  @*   <form onsubmit="handleLogin(event, 'ic')"> *@
                        <div id="error-message" class="alert-message" style="display: none;"></div>
                        
                        <div class="form-floating">
                            <InputText type="text" class="form-control" @bind-Value="modelDB.UserId" id="ic-input" placeholder="No. Kakitangan" 
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0,4)" maxlength="4" required />
                            <label for="ic-input"><i class="bi bi-person-badge me-2"></i>No. Kakitangan</label>
                        </div>

                        <div class="form-floating">
                            <InputText type="password" class="form-control" @bind-Value="modelDB.Password" id="ic-password" placeholder="Katalaluan" 
                                   minlength="6" required />
                            <label for="ic-password"><i class="bi bi-lock me-2"></i>Katalaluan</label>
                        </div>

                        <button type="submit" class="btn btn-success btn-login w-100 mb-3">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Log Masuk
                        </button>
                  @*   </form> *@
                </div>
            </EditForm>

              <EditForm Model="@modelDBA" FormName="Awam" OnValidSubmit="LoginRecordA">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                <!-- Email Login Form -->
                <div class="login-form" id="email-form">
                   @*  <form onsubmit="handleLogin(event, 'email')"> *@
                        <div id="error-message-email" class="alert-message" style="display: none;"></div>

                        <div class="form-floating">
                            <InputText type="text" class="form-control" @bind-Value="modelDBA.UserId" id="email-input" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0,12)" placeholder="No. Kad Pengenalan" required />
                            <label for="email-input"><i class="bi bi-envelope me-2"></i>No. Kad Pengenalan</label>
                        </div>

                        <div class="form-floating">
                            <InputText type="password" class="form-control" @bind-Value="modelDBA.Password" id="email-password" placeholder="Katalaluan"
                                   minlength="6" required />
                            <label for="email-password"><i class="bi bi-lock me-2"></i>Katalaluan</label>
                        </div>

                        <button type="submit" class="btn btn-success btn-login w-100 mb-3">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Log Masuk
                        </button>
                    @* </form> *@
                </div>
                 </EditForm>
              

               

                <div class="text-center">
                    <button class="btn btn-link text-muted" onclick="resetSelection()">
                        <i class="bi bi-arrow-left me-1"></i>Kembali ke pilihan
                    </button>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="quick-actions">
                <div class="row text-center">
                    <div class="col-6">
                    <a href="LupaKatalaluan" class="quick-action-btn" onclick="showForgotPassword()">
                            <i class="bi bi-key me-1"></i>Lupa Katalaluan?
                        </a>
                    </div>
                    <div class="col-6">
                    <a href="PendaftaranId" class="quick-action-btn" onclick="showRegistration()">
                            <i class="bi bi-person-plus me-1"></i>Daftar Akaun Baru
                        </a>
                    </div>
                </div>
               @*  <div class="text-center mt-3">
                    <a href="#" class="quick-action-btn">
                        <i class="bi bi-house me-1"></i>Laman Utama
                    </a>
                </div> *@
                <div class="version-info">
                    <strong>Version 1.0.0</strong>
                </div>
            </div>
        </div>
    </div>

