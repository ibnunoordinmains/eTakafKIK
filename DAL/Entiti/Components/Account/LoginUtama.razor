                        <div class="method-icon me-3">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <div>
                            <h6 class="mb-1 fw-bold">Orang AWAM</h6>
                            <small class="text-muted">Untuk kegunaan orang awam sahaja</small>
                        </div>
